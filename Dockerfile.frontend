# syntax=docker/dockerfile:1.7
# =============================================================================
# Frontend — Azure Container Apps target
# =============================================================================
# Serves the built React SPA via nginx as a non-root user (UID 101).
# The Application Gateway routes /* (non-API) traffic to this container.
# Listen port: 3000 — must match the Container App ingress targetPort.
# =============================================================================

# ---------- Stage 1: build ----------
FROM node:22-alpine AS build

WORKDIR /app

# Manifests first for layer caching.
# Lockfile is mandatory (no glob): a missing lockfile must fail the build,
# not silently produce a non-reproducible dependency tree.
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/package.json

RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund

COPY frontend ./frontend

RUN npm run build -w frontend

# ---------- Stage 2: nginx runtime ----------
# nginx-unprivileged ships an nginx.conf already adapted for non-root:
# no "user" directive, pid in /tmp, all temp paths under /tmp.
# This is what fixes the /var/cache/nginx permission-denied crash.
FROM nginxinc/nginx-unprivileged:1.30-alpine AS runtime

# The base image declares USER 101, so apk needs an explicit root switch.
# Targeted fix for CVE-2026-31789 (libcrypto3/libssl3 >= 3.5.6).
# Remove the explicit package upgrade once the base image ships >= 3.5.6.
USER root
RUN apk upgrade --no-cache \
 && apk add --no-cache --upgrade libcrypto3 libssl3
USER 101

# Server config as a real file: inspectable, diffable, lintable.
COPY --chown=101:101 frontend/nginx/default.conf /etc/nginx/conf.d/default.conf

COPY --from=build --chown=101:101 /app/frontend/dist /usr/share/nginx/html

EXPOSE 3000

# Not used by Azure Container Apps (which applies its own probes).
# Kept for local runs and the CI smoke test.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/healthz >/dev/null 2>&1 || exit 1