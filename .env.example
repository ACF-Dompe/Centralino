# =============================================================================
# Cisco Guest Desk — Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust for your environment.
# For Azure Container Apps deployment, these values are injected via ACA
# environment variables (with Key Vault references for secrets).
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# For local dev with password auth:
#   DATABASE_URL=postgres://user:password@host:5432/dbname
# For ACA with Entra ID Managed Identity (no password) — the user MUST be the
# backend UAMI name (that is the Entra login role on the server):
#   DATABASE_URL=postgres://uami-guestportal-backend-dev@psql-guestportal-dev.postgres.database.azure.com:5432/guestportal_dev
DATABASE_URL=postgres://postgres:password@localhost:5432/guest_desk

# Enable TLS for DB connections (true in production/ACA, false for local dev).
# DB_SSL_ENABLED=true
# Validate the server certificate chain (fail-closed default: true). Set to
# false ONLY for a local server with a self-signed certificate.
# DB_SSL_REJECT_UNAUTHORIZED=true

# ── WLC Defaults ────────────────────────────────────────────────────────────
WLC_DEFAULT_HOST=172.18.106.100
WLC_DEFAULT_PORT=443
WLC_DEFAULT_SSH_PORT=22
WLC_DEFAULT_USERNAME=admin_guest
WLC_DEFAULT_SSID=Dompe Guest

# ── WLC admin password — per-sede, Key Vault only (§2) ───────────────────────
# The WLC password is NEVER stored in the DB. There is one Key Vault secret per
# sede (WLC-PASSWORD-<CODE>), injected as an env var WLC_PASSWORD_<CODE> via a
# Key Vault reference in ACA. The app resolves sede.code → WLC_PASSWORD_<CODE>.
# Sede codes: MIL, AQ, NA, TIR, SM.
#   WLC_PASSWORD_MIL=secretref:wlc-password-mil   (the app secret being bound
#   to the Key Vault secret WLC-PASSWORD-MIL — see the section at the bottom)
#   WLC_PASSWORD_AQ=...  WLC_PASSWORD_NA=...  WLC_PASSWORD_TIR=...  WLC_PASSWORD_SM=...
# WLC_DEFAULT_PASSWORD is an OPTIONAL local-dev fallback only (never in prod).
# WLC_DEFAULT_PASSWORD=

# WLC HTTP/SSH request timeout (ms)
WLC_HTTP_TIMEOUT_MS=10000
WLC_SSH_TIMEOUT_MS=10000

# Verify the WLC SSH host key. Default: FALSE (verification off).
#
# Off by design for now: the five controllers have five different host keys
# while WLC_SSH_HOST_KEY below holds a single one, so turning this on today
# would let at most one sede connect and fail the other four closed.
#
# SECURITY: while off, the SSH session is not authenticated and is therefore
# exposed to MITM on the path to the controller — and that session carries the
# WLC admin password and the guest credentials. Acceptable only because the
# path is an internal managed network; recorded as an accepted deviation in
# COMPLIANCE.md. The backend logs a warning the first time it opens an
# unverified connection, so the state is visible rather than silent.
#
# Before turning it on, per-sede keys (WLC_SSH_HOST_KEY_<CODE>) are needed.
# WLC_SSH_VERIFY_HOST_KEY=false

# Expected SSH host key (base64 fingerprint or hex). Used ONLY when
# WLC_SSH_VERIFY_HOST_KEY=true, in which case a missing value fails closed.
# Example (base64): AAAAB3NzaC1yc2EAAAADAQABAAABAQ...
# WLC_SSH_HOST_KEY=

# WLC TLS verification — must be true in production.
# Set to false only for local dev with self-signed WLC certificates.
# WLC_TLS_REJECT_UNAUTHORIZED=true

# ── SSO SAML 2.0 via Microsoft Entra ID ────────────────────────────────────
# All SAML vars are optional. When SAML_ENTRY_POINT is empty, SSO is disabled
# and the app falls back to WLC-only authentication (useful for local dev).
#
# To enable SSO, register the app in Azure AD (Enterprise Applications):
#   - Identifier (Entity ID): unique URI for this app instance
#   - Reply URL (ACS):      https://<app-fqdn>/api/auth/callback
#   - Logout URL:           https://<app-fqdn>/api/auth/slo/callback
#   - Attributes & Claims:  emailaddress, name, givenname, surname
# <app-fqdn> convention (zone dompe.com): prod = guestportal.dompe.com (NO
# suffix); non-prod = guestportal-stg.dompe.com / guestportal-dev.dompe.com.
#
# Download the Federation Metadata XML and extract the values below.
# ────────────────────────────────────────────────────────────────────────────

# The IdP SAML SSO endpoint URL (from Federation Metadata XML → SingleSignOnService)
# Example: https://login.microsoftonline.com/<tenant-id>/saml2
# SAML_ENTRY_POINT=

# Application Entity ID (as configured in Azure AD App Registration)
# SAML_ISSUER=

# Public callback URL where Entra ID POSTs the SAML response
# SAML_CALLBACK_URL=

# Azure AD public certificate (PEM format) for signature verification.
# In ACA, bind it as an app secret and use SAML_CERT=secretref:saml-cert
# (see the Key Vault section at the bottom — the @Microsoft.KeyVault syntax
# does NOT work in Container Apps).
# SAML_CERT=

# Private key for decrypting SAML assertions (only if Azure AD is configured
# to encrypt assertions — optional).
# In ACA: SAML_DECRYPTION_KEY=secretref:saml-decryption-key
# SAML_DECRYPTION_KEY=

# SAML nameID format (default: urn:oasis:names:tc:SAML:2.0:nameid-format:persistent)
# SAML_IDENTIFIER_FORMAT=

# Omit RequestedAuthnContext from the AuthnRequest. Default: true. LEAVE IT TRUE
# against Entra ID.
#
# node-saml defaults to requesting PasswordProtectedTransport with
# Comparison="exact". Entra ID honours that, so every user who signed in with
# certificate-based auth, Windows Hello or FIDO2 is rejected with:
#   AADSTS75011: Authentication method 'X509, MultiFactor, X509Device' ...
#   doesn't match requested authentication method 'Password, ProtectedTransport'
# Which method is acceptable is decided by Conditional Access in Entra, not by
# this application. Set to false only for an IdP that demands an explicit
# authentication context.
# SAML_DISABLE_REQUESTED_AUTHN_CONTEXT=true

# Require the <Response> element to be signed, not only the <Assertion>.
# Default: true (hardening). Entra IDs default Signing Option is
# "Sign SAML assertion", which signs the assertion ONLY — against that default
# every login fails with "Invalid document signature".
#
# Preferred fix: in the Enterprise Application, SAML Certificates > Edit >
# Signing Option = "Sign SAML response and assertion". Set this variable to
# false only when that setting cannot be changed; the identity claims stay
# protected either way, because assertion signing is unconditional.
# SAML_WANT_AUTHN_RESPONSE_SIGNED=true

# IdP Single Logout endpoint URL (from Federation Metadata XML → SingleLogoutService)
# If not set, SLO is disabled (logout destroys only the local session).
# SAML_LOGOUT_URL=

# Where the IdP sends the SAML LogoutResponse after SLO.
# Defaults to SAML_CALLBACK_URL with /callback replaced by /slo/callback.
# SAML_LOGOUT_CALLBACK_URL=

# ── Break-glass access (emergency local login) ─────────────────────────────
# A username/password login that works when Entra ID / SAML SSO is down.
#
# ⚠️  It bypasses Entra Conditional Access and MFA, and carries NO second
#     factor by design (documented, accepted deviation — see COMPLIANCE.md).
#     Keep it disabled unless you need it, and set BREAKGLASS_IP_ALLOWLIST.
#
# Accounts live in the `breakglass_users` table and are created ONLY with the
# CLI — there is deliberately no HTTP endpoint for managing them.
#   Locally:      make breakglass ARGS="list"
#   In container: node backend/dist/scripts/breakglass.js list
#
# It depends on PostgreSQL, so it covers an Entra/SSO outage — NOT a database
# outage (which would already have taken sessions down with it).
# ────────────────────────────────────────────────────────────────────────────

# Master kill switch. Default: false — the feature ships dark.
# BREAKGLASS_ENABLED=false

# Session lifetime for a break-glass login, in minutes (default 120).
# Deliberately shorter than the 24 h SSO session.
# BREAKGLASS_SESSION_TTL_MINUTES=120

# Consecutive wrong passwords before the account is locked (default 5), and how
# long the lock lasts in minutes (default 15). The counters live in the database,
# so the lockout is shared by every ACA replica.
# BREAKGLASS_MAX_FAILED_ATTEMPTS=5
# BREAKGLASS_LOCKOUT_MINUTES=15

# Per-source-IP throttle: failures allowed (default 10) inside a sliding window
# in minutes (default 15). Held in process memory, therefore per replica — the
# account lockout above is the control that holds globally.
# BREAKGLASS_MAX_ATTEMPTS_PER_IP=10
# BREAKGLASS_IP_WINDOW_MINUTES=15

# Comma-separated CIDRs allowed to reach the break-glass endpoint (IPv4/IPv6).
# Empty = no network restriction. STRONGLY RECOMMENDED: with no second factor
# in play this is the most effective compensating control. Callers outside the
# list get a 404 and never see the emergency link in the UI.
# Fail-closed: if every entry is malformed, all requests are denied.
# BREAKGLASS_IP_ALLOWLIST=10.0.0.0/8,192.168.0.0/16

# Bootstrap account, created by the database migration when it does not exist.
#
# This is what makes a fresh deployment usable at all: every SSO user is created
# blocked, so somebody has to be able to profile the first administrators, and
# this account is that somebody.
#
# ⚠️  SECRET. There is deliberately no default: leave it empty and the account is
# simply not created (use `make breakglass ARGS="set bk.guestportal ..."`
# instead). A built-in default would be a backdoor published in the repository,
# and a generated one would be a credential nobody could use. Must be at least
# 16 characters or the migration refuses it.
#
# Bind it to the MIGRATION JOB only, not to the long-running backend container:
# the backend never needs it (SKIP_MIGRATIONS=true in production).
# After the first sign-in, rotate it from the CLI and file the new password in
# the password manager — the Key Vault value is then no longer the live one.
# In ACA: BREAKGLASS_SEED_PASSWORD=secretref:breakglass-seed-password
# BREAKGLASS_SEED_PASSWORD=
# BREAKGLASS_SEED_USERNAME=bk.guestportal
# BREAKGLASS_SEED_DISPLAY_NAME=Break Glass Guest Portal

# ── Authorization (RBAC) ────────────────────────────────────────────────────
# Roles and site grants live in `app_users` and are resolved per request, never
# cached in the session — a session lasts a day, and a suspended user has to
# lose access in seconds.
#
# How long an authorization decision may be stale, per replica. Kept below the
# dashboard's 30s poll on purpose: a suspended user loses access at their next
# automatic refresh, without having to click anything. Lower it to react faster,
# at the cost of one lookup per request per user.
# RBAC_CACHE_TTL_SECONDS=15
#
# 'log-only' records what would have been refused and lets it through — a way to
# watch the first rollout before it can lock anybody out of a working system.
# The code ships enforcing; a deployment that turns this off says so at startup.
# RBAC_ENFORCEMENT=enforce

# ── Session ─────────────────────────────────────────────────────────────────
# Secret used to sign session cookies. Must be a long, random string.
# In ACA: SESSION_SECRET=secretref:session-secret
# SESSION_SECRET=

# ── Azure (ACA deployment) ─────────────────────────────────────────────────
# Application Insights (optional) — set the connection string to enable
# telemetry. In ACA, bind it as an app secret and use:
#   APPLICATIONINSIGHTS_CONNECTION_STRING=secretref:appinsights-connection-string
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# Backend internal FQDN for server-side ACA internal calls
# Format: http://ca-{appname}-backend-{env}.{aca-environment-default-domain}
# BACKEND_BASE_URL=

# Azure region (telemetry tag)
# AZURE_REGION=westeurope

# ── Microsoft Graph API Email ────────────────────────────────────────────────
# Platform-provided App Registration with Mail.Send permission.
# Mail is delivered ONLY via Microsoft Graph (§3 — SMTP removed). When Graph is
# not configured (local dev) the credential email is logged to the console.
# In ACA, secrets must use Key Vault references.
# MAIL_GRAPH_ENABLED=true
# MAIL_GRAPH_TENANT_ID=<tenant-id>
# MAIL_GRAPH_CLIENT_ID=<client-id>
# MAIL_GRAPH_CLIENT_SECRET=<client-secret>
# MAIL_GRAPH_USER_ID=<user-object-id-or-upn>  # Mailbox that sends
# MAIL_GRAPH_FROM_ADDRESS=noreply@dompe.com

# ── Database Migration & Seed Controls ────────────────────────────────────
# Guidelines: migrations are a CI pipeline step (not run at app startup).
# Set SKIP_MIGRATIONS=true in production environments deployed via CI.
# SEED_ENABLED defaults to true in non-production, false in production.
# SKIP_MIGRATIONS=true
# SEED_ENABLED=false

# ── Key Vault Reference Quick Reference ─────────────────────────────────────
# Below is the complete list of secrets that must be stored in Key Vault
# and referenced from ACA environment variables.
#
# ⚠️  Azure Container Apps does NOT understand the App Service / Functions
#     syntax "@Microsoft.KeyVault(SecretUri=...)". Setting an env var to that
#     string passes the LITERAL text to the container. It cost us a production
#     incident: SAML_CERT held the reference text, so every SSO login failed
#     with "idpCert is not in PEM format or in base64 format" — and
#     SESSION_SECRET held it too, which made the cookie signing key derivable
#     from public information.
#
# In ACA a Key Vault secret is bound in two steps. First declare an app secret
# that points at the vault, using a user-assigned identity that holds the
# "Key Vault Secrets User" role on it:
#
#   UAMI_ID=$(az identity list --query "[?name=='<uami-backend>'].id | [0]" -o tsv)
#   az containerapp secret set -n <app> -g <rg> --secrets #     "saml-cert=keyvaultref:https://<kv>.vault.azure.net/secrets/SAML-CERT,identityref:$UAMI_ID"
#
# Then point the environment variable at that app secret:
#
#   az containerapp update -n <app> -g <rg> --set-env-vars SAML_CERT=secretref:saml-cert
#
# ACA secret names are lowercase (letters, digits and -); the Key Vault secret
# keeps its own UPPERCASE-WITH-HYPHENS name. Omitting the version from the
# secret URI lets ACA pick up rotations automatically.
#
# Naming convention:
#   Key Vault: kv-guestportal-{env}  (e.g. kv-guestportal-dev, -stg, -prod)
#   Secret name: UPPERCASE-WITH-HYPHENS
#
# NOTE: DATABASE_URL is NOT a Key Vault secret — with Entra ID auth it carries
# no password, so it is passed as a plain (non-secret) ACA env var.
#
# ┌───────────────────────────────────┬──────────┬─────────────────────────────┐
# │ Env var                           │ Required │ Key Vault secret name       │
# ├───────────────────────────────────┼──────────┼─────────────────────────────┤
# │ SESSION_SECRET                    │    ✅    │ SESSION-SECRET              │
# │ WLC_PASSWORD_<CODE> (per sede)    │    ✅    │ WLC-PASSWORD-<CODE>         │
# │ SAML_ENTRY_POINT                  │    ✅    │ SAML-ENTRY-POINT            │
# │ SAML_ISSUER                       │    ✅    │ SAML-ISSUER                 │
# │ SAML_CALLBACK_URL                 │    ✅    │ SAML-CALLBACK-URL           │
# │ SAML_CERT                         │    ✅    │ SAML-CERT                   │
# │ SAML_DECRYPTION_KEY               │    🔶    │ SAML-DECRYPTION-KEY         │
# │ SAML_LOGOUT_URL                   │    🔶    │ SAML-LOGOUT-URL             │
# │ SAML_LOGOUT_CALLBACK_URL          │    🔶    │ SAML-LOGOUT-CALLBACK-URL    │
# │ APPLICATIONINSIGHTS_CONNECTION_STRING │ 🔶  │ APPINSIGHTS-CONNECTION-STRING│
# └───────────────────────────────────┴──────────┴─────────────────────────────┘
#
# ✅ = Required in all environments
# 🔶 = Required only if the corresponding feature is enabled
#
# NOTE: the BREAKGLASS_* variables are switches and thresholds, passed as plain
# ACA env vars — with ONE exception. BREAKGLASS_SEED_PASSWORD is a secret and
# belongs in Key Vault (BREAKGLASS-SEED-PASSWORD, 🔶), bound to the migration
# job only. Every other break-glass password never appears in configuration at
# all: it is hashed with scrypt into the `breakglass_users` table by the CLI,
# and the plaintext lives in the password manager only.
#
# NOTE: WLC_PASSWORD_<CODE> is no longer a fixed set of five. Sites are created
# from the admin panel, and each new one needs its own Key Vault secret
# (WLC-PASSWORD-<CODE>) and env binding — which means a new ACA revision. The
# admin panel shows both names for a site whose password is missing, and keeps
# that site out of service until a connection test succeeds.
#
# ⚠️  IMPORTANT: ACR immutabile tag lock: az acr repository update --name <acr> --image <image>:<sha> --delete-enabled false --write-enabled false
# ⚠️  Dopo aver creato/aggiornato un Key Vault reference, la revisione ACA
#    deve essere riavviata per rendere effettive le modifiche.
#
# To set a secret in Key Vault:
#   az keyvault secret set \
#     --vault-name kv-guestportal-dev \
#     --name SESSION-SECRET \
#     --value "your-random-secret-here"
#
# The UAMI for each container app must have the 'Key Vault Secrets User' role:
#   az role assignment create \
#     --assignee <uami-principal-id> \
#     --role "Key Vault Secrets User" \
#     --scope /subscriptions/<sub>/resourceGroups/rg-guestportal-{env}/providers/Microsoft.KeyVault/vaults/kv-guestportal-{env}
